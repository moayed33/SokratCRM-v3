@push('scripts')
<script>
 (() => {
  const confirmForm =
   document.getElementById(
    'confirmImportForm'
   );

  confirmForm?.addEventListener(
   'submit',
   (event) => {
    const confirmed =
     window.confirm(
      'سيتم الآن إضافة العملاء '
      + 'الصالحة فقط إلى CRM. '
      + 'العملاء المكررة أو الصفوف '
      + 'التي بها أخطاء لن تتم إضافتها. '
      + 'هل تريد المتابعة؟'
     );

    if (!confirmed) {
     event.preventDefault();
    }
   }
  );
 })();
</script>
@endpush
