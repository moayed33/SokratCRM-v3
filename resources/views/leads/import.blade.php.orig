          @if (!empty($row['errors']))
           <ul class="row-errors">
            @foreach (
             $row['errors']
             as $error
            )
             <li>{{ $error }}</li>
            @endforeach
           </ul>
          @endif

          @if (!empty($row['warnings']))
           <ul class="row-warnings">
            @foreach (
             $row['warnings']
             as $warning
            )
             <li>{{ $warning }}</li>
            @endforeach
           </ul>
          @endif

          @if (
           !$row['duplicate_reason']
           && empty($row['errors'])
           && empty($row['warnings'])
          )
           ----
