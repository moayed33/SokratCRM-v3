         <td>
          @if ($row['state'] === 'valid')
           <span class="badge valid">
            صالح
           </span>
          @elseif (
           $row['state']
           === 'duplicate'
          )
           <span class="badge duplicate">
            مكرر
           </span>
          @else
           <span class="badge error">
            خطأ
           </span>
